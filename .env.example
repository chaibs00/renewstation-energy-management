# Copy this file to .env and change the passwords.

# PostgreSQL (silver layer)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=disable

# Airflow
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
# Linux: set to the output of `id -u` so Airflow can write to ./models and ./logs
AIRFLOW_UID=

# Local runs only (inside Docker this is /opt/airflow/models)
MODEL_DIR=
